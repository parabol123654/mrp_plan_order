<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plan Order -->
    <record id="view_plan_order_form" model="ir.ui.view">
        <field name="name">plan.order.form</field>
        <field name="model">plan.order</field>
        <field name="arch" type="xml">
            <form string="Plan Order">
                <header>
                    <button name="action_confirm" string="Confirm &amp; Hold stock" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_run_plan" string="Run Plan" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"
                            confirm="Run Plan releases the holds, creates OUT / MO / PO and reserves them immediately. Continue?"/>
                    <button name="action_reserve_again" string="Re-reserve" type="object" invisible="state != 'confirmed'"
                            confirm="Release everything and hold again from current stock (manual adjustments are lost). Continue?"/>
                    <button name="action_reserve_lower_levels" string="Recompute lower levels" type="object" invisible="state != 'confirmed'"
                            help="Keep finished-good holds (level 0) as adjusted, recompute component holds on lower levels."/>
                    <button name="action_release_all" string="Release all holds" type="object" invisible="state != 'confirmed'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state not in ('confirmed', 'cancel')"/>
                    <button name="action_check_done" string="Check done" type="object" invisible="state != 'running'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,running,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reservations" type="object" class="oe_stat_button" icon="fa-lock"
                                invisible="state in ('draft',)">
                            <field name="reservation_count" widget="statinfo" string="Holds"/>
                        </button>
                        <button name="action_view_productions" type="object" class="oe_stat_button" icon="fa-wrench"
                                invisible="production_count == 0">
                            <field name="production_count" widget="statinfo" string="MO"/>
                        </button>
                        <button name="action_view_purchases" type="object" class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="purchase_count == 0">
                            <field name="purchase_count" widget="statinfo" string="PO"/>
                        </button>
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                            <field name="user_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_plan"/>
                            <field name="date_run"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Demand lines" name="lines">
                            <button name="action_open_add_line_wizard" type="object" string="Add SO / Claim / Demand"
                                    class="btn-secondary mb-2" invisible="state != 'draft'"/>
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="false" decoration-danger="qty_short > 0 and state != 'draft'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="company_id" invisible="1"/>
                                    <field name="source_type"/>
                                    <field name="sale_line_id" optional="hide" readonly="1"/>
                                    <field name="claim_line_id" optional="hide" readonly="1"/>
                                    <field name="demand_line_id" optional="hide" readonly="1"/>
                                    <field name="origin" string="Source"/>
                                    <field name="partner_id"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom" groups="uom.group_uom"/>
                                    <field name="date_planned"/>
                                    <field name="need_delivery"/>
                                    <field name="qty_reserved"/>
                                    <field name="qty_short"/>
                                    <field name="state" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Stock holds (BOM level)" name="holds">
                            <field name="reservation_ids" readonly="state != 'confirmed'">
                                <list decoration-muted="state != 'reserved'" create="false" editable="bottom">
                                    <field name="bom_level" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="parent_product_id" readonly="1"/>
                                    <field name="plan_line_id" optional="hide" readonly="1"/>
                                    <field name="location_id" readonly="1"/>
                                    <field name="lot_id" groups="stock.group_production_lot" readonly="1"/>
                                    <field name="quantity" readonly="state != 'reserved'"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                    <field name="state"/>
                                    <button name="action_release" type="object" string="Release" icon="fa-unlock"
                                            invisible="state != 'reserved'"/>
                                    <button name="action_hold" type="object" string="Hold" icon="fa-lock"
                                            invisible="state != 'released'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_plan_order_tree" model="ir.ui.view">
        <field name="name">plan.order.tree</field>
        <field name="model">plan.order</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'confirmed'" decoration-success="state == 'running'"
                  decoration-muted="state in ('done', 'cancel')">
                <field name="name"/>
                <field name="date_plan"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <field name="line_count" string="Lines"/>
                <field name="reservation_count" string="Holds"/>
                <field name="production_count" string="MO"/>
                <field name="purchase_count" string="PO"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_plan_order_search" model="ir.ui.view">
        <field name="name">plan.order.search</field>
        <field name="model">plan.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="my" string="My plans" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_wh" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_plan_order" model="ir.actions.act_window">
        <field name="name">Plan Orders</field>
        <field name="res_model">plan.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1, 'search_default_confirmed': 1, 'search_default_running': 1}</field>
    </record>

    <!-- Reservation standalone views -->
    <record id="view_plan_reservation_tree" model="ir.ui.view">
        <field name="name">plan.reservation.tree</field>
        <field name="model">plan.reservation</field>
        <field name="arch" type="xml">
            <list create="false" decoration-muted="state != 'reserved'" editable="bottom">
                <field name="plan_id" readonly="1"/>
                <field name="bom_level" readonly="1"/>
                <field name="product_id" readonly="1"/>
                <field name="parent_product_id" readonly="1"/>
                <field name="location_id" readonly="1"/>
                <field name="lot_id" groups="stock.group_production_lot" readonly="1"/>
                <field name="quantity" readonly="state != 'reserved'"/>
                <field name="state"/>
                <button name="action_release" type="object" string="Release" icon="fa-unlock"
                        invisible="state != 'reserved'"/>
                <button name="action_hold" type="object" string="Hold" icon="fa-lock"
                        invisible="state != 'released'"/>
            </list>
        </field>
    </record>

    <record id="view_plan_reservation_search" model="ir.ui.view">
        <field name="name">plan.reservation.search</field>
        <field name="model">plan.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="plan_id"/>
                <filter name="reserved" string="Reserved" domain="[('state', '=', 'reserved')]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_level" string="BOM level" context="{'group_by': 'bom_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_plan_reservation" model="ir.actions.act_window">
        <field name="name">Stock holds</field>
        <field name="res_model">plan.reservation</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_reserved': 1, 'search_default_group_product': 1}</field>
    </record>
</odoo>
