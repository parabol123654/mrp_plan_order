<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_plan" model="ir.ui.view">
        <field name="name">sale.order.form.plan</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="after">
                <field name="plan_qty" optional="show"/>
                <field name="plan_remaining_qty" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
